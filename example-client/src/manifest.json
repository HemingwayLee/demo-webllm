{
  "manifest_version": 3,
  "name": "WebLLM Example Client",
  "version": "0.1.0",
  "description": "Chats with a model downloaded by WebLLM Model Manager, without downloading it again.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "WebLLM Example Client",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "storage"
  ]
}
